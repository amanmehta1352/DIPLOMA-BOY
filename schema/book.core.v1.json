{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "book.core.v1",
  "title": "Chapter core: verified facts, examples and questions. Styles (saral, abhyas …) are built from this by code.",
  "description": "Text fields are plain text. Fractions: [[top|bottom]]. Superscripts as Unicode (², ⁻⁸). No Markdown, LaTeX or HTML, except figures[].svg.",
  "type": "object",
  "required": ["schema", "id", "level_family", "subject", "no", "title_hi", "title_en", "intro", "learn", "prereq", "sections", "mistakes", "summary", "questions"],
  "properties": {
    "schema": { "const": "book.core.v1" },
    "id": { "type": "string", "description": "qual/subject/chapter-slug" },
    "level_family": { "enum": ["basic", "board", "technical", "higher"] },
    "subject": { "type": "object", "required": ["hi", "en"] },
    "level_hi": { "type": "string" },
    "no": { "type": "integer", "minimum": 1 },
    "title_hi": { "type": "string" },
    "title_en": { "type": "string" },
    "intro": { "type": "string" },
    "learn": { "type": "array", "minItems": 3, "maxItems": 6, "items": { "type": "string" } },
    "prereq": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string" } },
    "figures": {
      "type": "object",
      "additionalProperties": { "type": "object", "required": ["caption", "svg"], "properties": { "caption": { "type": "string" }, "svg": { "type": "string" } } }
    },
    "sections": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object",
        "required": ["key", "title", "intro", "defn", "explain", "examples", "checks"],
        "properties": {
          "key": { "type": "string" },
          "title": { "type": "string" },
          "intro": { "type": "string" },
          "defn": { "type": "string" },
          "explain": { "type": "array", "items": { "type": "object", "required": ["depth", "text"], "properties": { "depth": { "enum": ["core", "extra"] }, "text": { "type": "string" } } } },
          "figure": { "type": "string", "description": "key in figures" },
          "formula": { "type": "object", "required": ["eq", "symbols", "unit"], "properties": { "eq": { "type": "string" }, "symbols": { "type": "string" }, "unit": { "type": "string" }, "when": { "type": "string" } } },
          "examples": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/worked" } },
          "checks": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["q", "a"] } },
          "activity": { "$ref": "#/definitions/activity" },
          "know": { "type": "string" },
          "table": { "type": "object", "required": ["caption", "rows"] }
        }
      }
    },
    "mistakes": { "type": "array", "minItems": 3, "items": { "type": "object", "required": ["wrong", "right"] } },
    "summary": { "type": "array", "minItems": 6, "items": { "type": "string" } },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "level", "section", "q"],
        "properties": {
          "type": { "enum": ["mcq", "vshort", "short", "long", "numeric"] },
          "level": { "enum": [1, 2, 3] },
          "section": { "type": "string" },
          "q": { "type": "string" },
          "options": { "type": "array", "minItems": 4, "maxItems": 4 },
          "answer": {},
          "solution": { "type": "array", "items": { "type": "string" } },
          "calc": { "type": "string" },
          "value": { "type": "number" },
          "unit": { "type": "string" }
        }
      }
    }
  },
  "definitions": {
    "worked": {
      "type": "object",
      "required": ["level", "q", "given", "find", "formula", "steps", "answer", "calc", "value"],
      "properties": {
        "level": { "enum": [1, 2, 3] },
        "q": { "type": "string" }, "given": { "type": "string" }, "find": { "type": "string" }, "formula": { "type": "string" },
        "steps": { "type": "array", "items": { "type": "string" } },
        "answer": { "type": "string" },
        "calc": { "type": "string", "description": "JS arithmetic that must equal value (checked by tools/book/check.mjs)" },
        "value": { "type": "number" }
      }
    },
    "activity": {
      "type": "object",
      "required": ["title", "material", "steps", "table", "result"]
    }
  }
}
